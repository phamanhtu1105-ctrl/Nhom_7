<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mau_nen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/mau_chu_dao"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btnQuayLai"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Quay lại"
                android:src="@drawable/ic_trang_chu"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="NỘP ĐƠN ỨNG TUYỂN"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="28dp"
                android:layout_height="28dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Thẻ tóm tắt việc làm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTenViecLam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tên công việc"
                    android:textColor="@color/mau_chu_chinh"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTenNhaTuyenDung"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nhà tuyển dụng"
                    android:textColor="@color/mau_chu_phu"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvMucLuong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mức lương: 25.000 VNĐ/giờ"
                    android:textColor="@color/mau_phu"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lời giới thiệu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lời giới thiệu bản thân (*)"
                    android:textColor="@color/mau_chu_chinh"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nêu ngắn gọn lịch học, kinh nghiệm hoặc mong muốn công việc để gây ấn tượng với nhà tuyển dụng."
                    android:textColor="@color/mau_chu_phu"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edtLoiGioiThieu"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/khung_nhap_lieu"
                    android:gravity="top|start"
                    android:hint="Ví dụ: Em muốn đăng ký ca làm việc buổi tối vì ban ngày bận lịch học ở trường..."
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnGuiDon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/mau_chu_dao"
                android:text="GỬI ĐƠN ỨNG TUYỂN"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
