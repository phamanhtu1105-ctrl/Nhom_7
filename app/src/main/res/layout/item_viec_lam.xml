<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTenViecLam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên công việc"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHinhThucLamViec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/khung_nhap_lieu"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Bán thời gian"
                android:textColor="@color/mau_chu_dao"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTenNhaTuyenDung"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tên nhà tuyển dụng"
            android:textColor="@color/mau_chu_phu"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMucLuong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="25.000 VNĐ/giờ"
                android:textColor="@color/mau_phu"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiaDiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:text="Quận 1, TP.HCM"
                android:textColor="@color/mau_chu_phu"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvThoiGianLamViec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ca sáng / Ca tối"
            android:textColor="@color/mau_chu_phu"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
