<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mau_nen"
    tools:ignore="all">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:background="@color/mau_chu_dao"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnQuayLai"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_trang_chu"
            android:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_chi_tiet_cong_viec"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnYeuThich"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Lưu yêu thích"
            android:src="@drawable/ic_yeu_thich"
            android:tint="@color/white" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomAction"
        android:layout_below="@id/layoutHeader"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Thẻ Thông Tin Tổng Quan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTenViecLam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tên công việc"
                    android:textColor="@color/mau_chu_chinh"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTenNhaTuyenDung"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nhà tuyển dụng"
                    android:textColor="@color/mau_chu_phu"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/mau_vien" />

                <TextView
                    android:id="@+id/tvMucLuong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mức lương: 25.000 VNĐ/giờ"
                    android:textColor="@color/mau_phu"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiaDiem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Địa điểm: Quận 1, TP.HCM"
                    android:textColor="@color/mau_chu_chinh"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvThoiGianLamViec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Thời gian: Ca sáng 7h-11h"
                    android:textColor="@color/mau_chu_chinh"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvHinhThucLamViec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hình thức: Bán thời gian"
                    android:textColor="@color/mau_chu_chinh"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvHanUngTuyen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hạn ứng tuyển: 30/12/2026"
                    android:textColor="@color/mau_cam"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Mô tả công việc -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="MÔ TẢ CÔNG VIỆC"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMoTa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/white"
                android:padding="12dp"
                android:text="Chi tiết mô tả công việc..."
                android:textColor="@color/mau_chu_chinh"
                android:textSize="13sp" />

            <!-- Yêu cầu ứng viên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="YÊU CẦU ỨNG VIÊN"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvYeuCau"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/white"
                android:padding="12dp"
                android:text="Yêu cầu kỹ năng..."
                android:textColor="@color/mau_chu_chinh"
                android:textSize="13sp" />

            <!-- Quyền lợi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="QUYỀN LỢI ĐƯỢC HƯỞNG"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuyenLoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/white"
                android:padding="12dp"
                android:text="Quyền lợi sinh viên..."
                android:textColor="@color/mau_chu_chinh"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Nút Ứng tuyển -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnUngTuyen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/mau_chu_dao"
            android:text="ỨNG TUYỂN NGAY"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
