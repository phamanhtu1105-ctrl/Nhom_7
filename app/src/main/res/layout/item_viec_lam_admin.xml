<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    tools:ignore="all">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        tools:ignore="all">

        <!-- Title & Category Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="all">

            <TextView
                android:id="@+id/tvTenViecLamAdminItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên công việc"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="all" />

            <TextView
                android:id="@+id/tvDanhMucAdminItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/khung_nhap_lieu"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Bán hàng"
                android:textColor="@color/mau_chu_dao"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="all" />
        </LinearLayout>

        <!-- Company Name -->
        <TextView
            android:id="@+id/tvTenNhaTuyenDungAdminItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Highlands Coffee"
            android:textColor="@color/mau_chu_phu"
            android:textSize="13sp"
            tools:ignore="all" />

        <!-- Salary & Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="all">

            <TextView
                android:id="@+id/tvMucLuongAdminItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="25.000 VNĐ/giờ"
                android:textColor="@color/mau_phu"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="all" />

            <TextView
                android:id="@+id/tvDiaDiemAdminItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quận 1, TP.HCM"
                android:textColor="@color/mau_chu_phu"
                android:textSize="12sp"
                tools:ignore="all" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/mau_vien" />

        <!-- Admin Action Buttons (Sửa / Xóa) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            tools:ignore="all">

            <Button
                android:id="@+id/btnSuaViecAdmin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:text="✏️ Sửa"
                android:textColor="@color/mau_chu_dao"
                android:textSize="12sp"
                tools:ignore="all" />

            <Button
                android:id="@+id/btnXoaViecAdmin"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/mau_do"
                android:paddingHorizontal="14dp"
                android:text="🗑️ Xóa"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:ignore="all" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
