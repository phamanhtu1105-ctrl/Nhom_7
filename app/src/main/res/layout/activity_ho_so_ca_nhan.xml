<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mau_nen"
    tools:ignore="all">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:orientation="vertical"
        tools:ignore="all">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/mau_chu_dao"
            android:gravity="center"
            android:text="@string/title_ho_so_ca_nhan"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="all" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:ignore="all">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                tools:ignore="all">

                <!-- Thẻ Thông tin cá nhân -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    tools:ignore="all">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_thong_tin_ca_nhan"
                        android:textColor="@color/mau_chu_dao"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Mã sinh viên"
                        android:textColor="@color/mau_chu_phu"
                        android:textSize="12sp"
                        tools:ignore="all" />

                    <TextView
                        android:id="@+id/tvMaSinhVien"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="SV001"
                        android:textColor="@color/mau_chu_chinh"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Email"
                        android:textColor="@color/mau_chu_phu"
                        android:textSize="12sp"
                        tools:ignore="all" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="sv001@gmail.com"
                        android:textColor="@color/mau_chu_chinh"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/lbl_ho_ten_req"
                        android:textColor="@color/mau_chu_chinh"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <EditText
                        android:id="@+id/edtHoTen"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:background="@drawable/khung_nhap_lieu"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="10dp"
                        android:textSize="14sp"
                        tools:ignore="all" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/lbl_sdt_req"
                        android:textColor="@color/mau_chu_chinh"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <EditText
                        android:id="@+id/edtSoDienThoai"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:background="@drawable/khung_nhap_lieu"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        android:paddingHorizontal="10dp"
                        android:textSize="14sp"
                        tools:ignore="all" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/lbl_truong_hoc_req"
                        android:textColor="@color/mau_chu_chinh"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <EditText
                        android:id="@+id/edtTenTruong"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:background="@drawable/khung_nhap_lieu"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:textSize="14sp"
                        tools:ignore="all" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Giới thiệu bản thân"
                        android:textColor="@color/mau_chu_chinh"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <EditText
                        android:id="@+id/edtGioiThieu"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:background="@drawable/khung_nhap_lieu"
                        android:gravity="top|start"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:padding="8dp"
                        android:textSize="14sp"
                        tools:ignore="all" />

                    <Button
                        android:id="@+id/btnCapNhatHoSo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/mau_chu_dao"
                        android:text="LƯU THÔNG TIN HỒ SƠ"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                </LinearLayout>

                <!-- Thẻ Đổi Mật Khẩu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    tools:ignore="all">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_doi_mat_khau"
                        android:textColor="@color/mau_chu_dao"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                    <EditText
                        android:id="@+id/edtMatKhauCu"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:autofillHints=""
                        android:background="@drawable/khung_nhap_lieu"
                        android:hint="Mật khẩu hiện tại"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingHorizontal="10dp"
                        android:textSize="14sp"
                        tools:ignore="all" />

                    <EditText
                        android:id="@+id/edtMatKhauMoi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:autofillHints=""
                        android:background="@drawable/khung_nhap_lieu"
                        android:hint="Mật khẩu mới (ít nhất 6 ký tự)"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingHorizontal="10dp"
                        android:textSize="14sp"
                        tools:ignore="all" />

                    <EditText
                        android:id="@+id/edtXacNhanMatKhauMoi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:autofillHints=""
                        android:background="@drawable/khung_nhap_lieu"
                        android:hint="Xác nhận mật khẩu mới"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:paddingHorizontal="10dp"
                        android:textSize="14sp"
                        tools:ignore="all" />

                    <Button
                        android:id="@+id/btnDoiMatKhau"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/text_doi_mat_khau"
                        android:textColor="@color/mau_chu_dao"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="all" />

                </LinearLayout>

                <!-- Nút Đăng Xuất -->
                <Button
                    android:id="@+id/btnDangXuat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/mau_do"
                    android:text="@string/text_dang_xuat"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="all" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        app:itemIconTint="@color/mau_chu_dao"
        app:itemTextColor="@color/mau_chu_dao"
        app:menu="@menu/bottom_navigation_menu" />

</RelativeLayout>
