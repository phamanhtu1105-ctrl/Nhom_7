<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    tools:ignore="all">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        tools:ignore="all">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="all">

            <TextView
                android:id="@+id/tvTenViecLam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên công việc"
                android:textColor="@color/mau_chu_chinh"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="all" />

            <TextView
                android:id="@+id/tvTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/khung_nhap_lieu"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Chờ xét duyệt"
                android:textColor="@color/mau_cam"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="all" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTenNhaTuyenDung"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tên nhà tuyển dụng"
            android:textColor="@color/mau_chu_phu"
            android:textSize="13sp"
            tools:ignore="all" />

        <TextView
            android:id="@+id/tvMucLuong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mức lương: 25.000 VNĐ/giờ"
            android:textColor="@color/mau_phu"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="all" />

        <TextView
            android:id="@+id/tvLoiGioiThieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F9F9F9"
            android:padding="8dp"
            android:text="Lời giới thiệu..."
            android:textColor="@color/mau_chu_chinh"
            android:textSize="12sp"
            tools:ignore="all" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="all">

            <TextView
                android:id="@+id/tvNgayUngTuyen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ngày ứng tuyển: 02/11/2026"
                android:textColor="@color/mau_chu_phu"
                android:textSize="12sp"
                tools:ignore="all" />

            <Button
                android:id="@+id/btnHuyDon"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Hủy đơn"
                android:textColor="@color/mau_do"
                android:textSize="12sp"
                tools:ignore="all" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
